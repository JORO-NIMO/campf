<Window x:Class="LocalFirewall.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local App Firewall" Height="600" Width="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ComboBox Grid.Row="0" SelectedIndex="0" Margin="0,0,0,12">
            <ComboBoxItem Content="Allow only selected apps" />
            <ComboBoxItem Content="Block all apps" />
        </ComboBox>

        <DataGrid Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding Rules}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Executable" Binding="{Binding ExecutablePath}" Width="*" />
                <DataGridCheckBoxColumn Header="Allow Internet" Binding="{Binding AllowInternet}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Refresh Apps" Width="120" Margin="0,0,8,0" />
            <Button Content="Apply" Width="120" />
        </StackPanel>
    </Grid>
</Window>
